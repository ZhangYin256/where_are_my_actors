# =====================================================================
# 排练通知 QQ Bot 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 含敏感信息，切勿提交到版本库。
# =====================================================================

# ---------- NoneBot2 基础配置 ----------
# 驱动：正向 WebSocket 客户端使用 ~websockets
DRIVER=~websockets

# OneBot V11 正向 WebSocket 地址（Docker Compose 内为 ws://napcat:3001）
ONEBOT_WS_URLS=["ws://napcat:3001"]
# NapCat 中配置的 access token，必须与 NapCat 侧一致
ONEBOT_ACCESS_TOKEN=change-me-please

# 超级用户（NoneBot 内置），一般无需设置，业务管理员请使用 REHEARSAL_ADMINS
SUPERUSERS=[]

# 全局命令前缀（NoneBot 用，业务命令前缀见 REHEARSAL_COMMAND_PREFIX）
COMMAND_START=["/"]

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- 业务配置 ----------
# 初始管理员 QQ 号（全局管理员），多个用 JSON 数组
REHEARSAL_ADMINS=["10000001"]

# 数据库路径；Docker 内建议 /data/rehearsal.db
REHEARSAL_DB_PATH=data/rehearsal.db

# 业务命令前缀
REHEARSAL_COMMAND_PREFIX=#

# 默认时区
REHEARSAL_TIMEZONE=Asia/Shanghai

# 默认提醒分钟数（新建剧组时写入）
REHEARSAL_DEFAULT_REMIND_MINUTES=30

# 是否默认开启私聊提醒（新建剧组时写入）
REHEARSAL_DEFAULT_PRIVATE_REMIND=false

# 晚上模糊时间阈值（开始小时小于该值时按晚上解释）
REHEARSAL_EVENING_THRESHOLD=9

# 单条消息发送间隔（秒），防止触发风控
REHEARSAL_SEND_INTERVAL=1.0

# 长消息分段阈值（字符）
REHEARSAL_MAX_MESSAGE_CHARS=1500

# 提醒重试次数上限
REHEARSAL_MAX_REMINDER_ATTEMPTS=3

# 提醒扫描间隔（秒）
REHEARSAL_REMINDER_TICK_SECONDS=10

# 提醒任务宽限：触发时间超过该秒数视为已错过，不再补发
REHEARSAL_REMINDER_GRACE_SECONDS=90

# 降级逐个 @ 的目标范围：participants（仅参与人员）/ all_members（全体群成员）
REHEARSAL_DEGRADE_AT_SCOPE=participants

# 是否允许群主在未初始化剧组时自助初始化（首次上手更友好）
REHEARSAL_ALLOW_OWNER_INIT=true

# 群成员缓存时间（秒）
REHEARSAL_MEMBER_CACHE_SECONDS=300

# 心跳文件（供容器健康检查）
REHEARSAL_HEARTBEAT_PATH=data/heartbeat

# 日志目录
REHEARSAL_LOG_DIR=logs
